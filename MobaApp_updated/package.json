{
  "name": "moba-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "npx expo start --port 8081",
    "dev": "npx expo start --web --port 8081",
    "android": "npx expo start --android --port 8081",
    "ios": "npx expo start --ios --port 8081",
    "web": "npx expo start --web --port 8081",
    "server:user": "json-server --watch db.json --port 3000 --host 0.0.0.0",
    "server:admin": "json-server --watch db.json --port 3001 --host 0.0.0.0",
    "server": "npx concurrently -n user,admin -c blue,red \"npm run server:user\" \"npm run server:admin\"",
    "app": "npx concurrently -n server,web -c green,cyan \"npm run server\" \"npm run web\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "~14.0.4",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.18",
    "@react-navigation/stack": "^6.4.1",
    "axios": "^1.7.9",
    "expo": "~52.0.0",
    "expo-blur": "~14.0.1",
    "expo-linear-gradient": "~14.0.1",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-gesture-handler": "~2.20.2",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "concurrently": "^9.1.2",
    "json-server": "^0.17.4"
  },
  "private": true
}
