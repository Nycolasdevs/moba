{
  "name": "moba-app",
  "version": "1.0.0",
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx expo start --port 8081",
    "dev": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx expo start --web --port 8081",
    "android": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx expo start --android --port 8081",
    "ios": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx expo start --ios --port 8081",
    "web": "cross-env EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 npx expo start --web --port 8081",
    "server:user": "json-server --watch db.json --port 3000 --host 0.0.0.0",
    "server:admin": "json-server --watch db.json --port 3001 --host 0.0.0.0",
    "server": "npx concurrently -n user,admin -c blue,red \"npm run server:user\" \"npm run server:admin\"",
    "app": "npx concurrently -n server,web -c green,cyan \"npm run server\" \"npm run web\""
  },
  "dependencies": {
    "@expo/metro-runtime": "~56.0.14",
    "@expo/vector-icons": "^15.0.2",
    "@gluestack-ui/icon": "^0.1.27",
    "@gluestack-ui/utils": "^3.0.21",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.17.0",
    "@react-navigation/native": "^7.2.6",
    "@react-navigation/native-stack": "^7.17.0",
    "axios": "^1.7.9",
    "expo": "^56.0.9",
    "expo-blur": "~56.0.3",
    "expo-constants": "~56.0.17",
    "expo-font": "^56.0.5",
    "expo-linear-gradient": "~56.0.4",
    "expo-linking": "~56.0.13",
    "expo-status-bar": "^56.0.4",
    "glob": "^10.4.5",
    "lucide-react-native": "^1.17.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "^15.15.5",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "concurrently": "^9.1.2",
    "cross-env": "^10.1.0",
    "json-server": "^0.17.4"
  },
  "private": true
}
